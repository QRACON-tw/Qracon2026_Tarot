---
import type { CardId } from '../../data/tarot';

interface Props {
  id: CardId;
}

const { id } = Astro.props;
---

<svg class="glyph" viewBox="0 0 40 40" aria-hidden="true" focusable="false">
  {id === 'fool' && (
    <>
      <path d="M2 14c4-8 8-8 12 0s8 8 12 0 8-8 12 0" />
      <path d="M2 24c4-8 8-8 12 0s8 8 12 0 8-8 12 0" />
    </>
  )}
  {id === 'lovers' && (
    <>
      <circle class="glyph__dot" cx="3" cy="20" r="2" />
      <path d="M5 20c5-9 9-9 14 0s9 9 14 0L35 20" />
      <circle class="glyph__dot" cx="37" cy="20" r="2" />
    </>
  )}
  {id === 'hermit' && (
    <>
      <path d="M2 21c3-8 6-8 9 0s6 8 9 0" />
      <path d="M22 7v26" />
      <circle class="glyph__dot" cx="32" cy="20" r="2.5" />
    </>
  )}
  {id === 'wheel' && (
    <>
      <path d="M3 30h34M3 22h34M3 14h34" />
      <path d="M14 29 27 11m0 0v8m0-8h-8" />
    </>
  )}
  {id === 'death' && (
    <>
      <path d="M4 9v22M8 7v26M12 10v20M16 6v28" />
      <path d="M20 8v24" stroke-opacity=".7" />
      <path d="M24 11v18M28 13v14" stroke-opacity=".45" />
      <path d="M32 16v8M36 18v4" stroke-opacity=".22" />
      <path d="M3 35h34" stroke-opacity=".35" />
    </>
  )}
  {id === 'tower' && (
    <>
      <path d="M3 32h8v-7h7v-7h7" />
      <path d="M25 18c3-8 6-8 9 0s3 8 4 4" />
    </>
  )}
  {id === 'sun' && (
    <>
      <path d="M2 20c4-8 8-8 12 0s8 8 12 0 8-8 12 0" stroke-width="3.5" />
      <path d="M2 20c4-8 8-8 12 0s8 8 12 0 8-8 12 0" stroke-width="1" />
    </>
  )}
</svg>

<style>
  .glyph {
    display: block;
    inline-size: 100%;
    aspect-ratio: 1;
    overflow: visible;
    fill: none;
    stroke: currentColor;
    stroke-width: var(--rule-thin);
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .glyph__dot {
    fill: currentColor;
  }
</style>
