---
import { Image } from 'astro:assets';
import type { TarotCard } from '../../data/tarot';
import TarotGlyph from './TarotGlyph.astro';
import backArt from '../../assets/tarot/tarot-back.png';

interface Props {
  card: TarotCard;
  class?: string;
  flip?: boolean;
}

const { card, class: className, flip = false } = Astro.props;
---

<span
  class:list={['card', { 'card--flip': flip }, className]}
>
  <span class="card__inner">
    <span class="card__face">
      {
        card.art ? (
          <Image
            src={card.art}
            alt=""
            aria-hidden="true"
            class="card__art"
            widths={[112, 168, 224, 336, 448]}
            sizes="(min-width: 48rem) 168px, (max-width: 34rem) 26vw, 132px"
            format="avif"
            quality={45}
            loading="lazy"
          />
        ) : (
          <span class="card__glyph" aria-hidden="true">
            <TarotGlyph id={card.id} />
          </span>
        )
      }
      <span class="card__numeral">{card.numeral}</span>
      <span class="card__caption">
        <span class="card__name-en">{card.nameEn}</span>
        <span class="card__persona">{card.persona}</span>
      </span>
    </span>
    {
      flip && (
        <span class="card__back" aria-hidden="true">
          <Image
            src={backArt}
            alt=""
            aria-hidden="true"
            class="card__back-art"
            width={448}
            format="avif"
            quality={70}
            loading="eager"
          />
        </span>
      )
    }
  </span>
</span>

<style>
  .card {
    position: relative;
    display: grid;
    width: 100%;
    aspect-ratio: 4 / 7;
    container-type: inline-size;
    border: var(--rule-thin) solid var(--color-ink);
    border-radius: var(--radius-chip);
    background: var(--color-white);
    color: var(--color-ink);
  }

  .card::before {
    content: '';
    position: absolute;
    inset: var(--space-2);
    z-index: 1;
    border: var(--rule-hair) solid var(--color-ink);
    border-radius: var(--radius-tile);
    pointer-events: none;
  }

  .card__inner {
    display: contents;
  }

  .card__face {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    overflow: hidden;
    border-radius: inherit;
    background: var(--color-white);
  }

  /* The art has a pure white margin, so shrinking it is seamless and widens the text bands to about 20% of the height. */
  .card__art {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    scale: 0.88;
  }

  /* Text stays inside the hairline frame and in the art's blank top and bottom bands. */
  .card__numeral {
    position: absolute;
    inset-block-start: calc(var(--space-2) + 2cqw);
    inset-inline: 0;
    text-align: center;
    font-family: var(--font-sign);
    font-weight: var(--weight-sign-heavy);
    font-size: 16cqw;
    line-height: 1;
    letter-spacing: 0.08em;
    padding-inline-start: 0.08em;
  }

  /* Paper strip: where a small card leaves the band short, it trims the lowest line work instead of overprinting it. */
  .card__caption {
    position: absolute;
    inset-inline: var(--space-2);
    inset-block-end: var(--space-2);
    display: grid;
    justify-items: center;
    gap: 1.5cqw;
    padding: 2.5cqw 3cqw 3.5cqw;
    border-radius: 0 0 var(--radius-tile) var(--radius-tile);
    background: var(--color-white);
    text-align: center;
  }

  .card__name-en {
    font-family: var(--font-sign);
    font-weight: var(--weight-sign-heavy);
    font-size: 7.5cqw;
    line-height: 1.1;
    letter-spacing: 0.1em;
    padding-inline-start: 0.1em;
    text-transform: uppercase;
    text-wrap: balance;
  }

  .card__persona {
    font-family: var(--font-sans);
    font-weight: var(--weight-black);
    font-size: 10cqw;
    line-height: var(--leading-tight);
    letter-spacing: 0.02em;
    padding-inline-start: 0.02em;
    text-wrap: balance;
  }

  .card__glyph {
    position: absolute;
    inset-block-start: 50%;
    inset-inline-start: 50%;
    width: min(40cqw, 2.5rem);
    aspect-ratio: 1;
    translate: -50% -50%;
  }

  .card--flip {
    border: 0;
    border-radius: 0;
    background: none;
    perspective: 40rem;
  }

  .card--flip::before {
    content: none;
  }

  .card--flip .card__inner {
    position: absolute;
    inset: 0;
    display: grid;
    transform-style: preserve-3d;
  }

  .card--flip .card__face,
  .card--flip .card__back {
    grid-area: 1 / 1;
    border-radius: var(--radius-chip);
    backface-visibility: hidden;
  }

  .card--flip .card__face {
    border: var(--rule-thin) solid var(--color-ink);
  }

  .card--flip .card__face::before {
    content: '';
    position: absolute;
    inset: var(--space-2);
    z-index: 1;
    border: var(--rule-hair) solid var(--color-ink);
    border-radius: var(--radius-tile);
    pointer-events: none;
  }

  .card__back {
    position: relative;
    overflow: hidden;
    border: var(--rule-thin) solid var(--color-white);
    background: var(--color-ink-raised);
    transform: rotateY(180deg);
  }

  .card__back-art {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .card__back::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(105deg, transparent 38%, var(--color-on-ink-sheen) 50%, transparent 62%);
    opacity: 0.16;
    translate: -110% 0;
    pointer-events: none;
  }

  :global(.js) .card--flip .card__inner {
    transform: rotateY(180deg);
    transition: transform var(--dur-flip) var(--ease-in-out);
  }

  :global(.js) .card--flip.is-flipped .card__inner {
    transform: none;
  }

  :global([data-fx='0']) .card--flip .card__inner {
    transform: none;
    transition: none;
  }

  :global([data-fx='0']) .card--flip .card__face,
  :global([data-fx='0']) .card--flip .card__back {
    backface-visibility: visible;
    transition: opacity var(--dur-fast) linear;
  }

  :global([data-fx='0']) .card--flip .card__back {
    transform: none;
  }

  :global([data-fx='0']) .card--flip .card__face,
  :global([data-fx='0']) .card--flip.is-flipped .card__back {
    opacity: 0;
  }

  :global([data-fx='0']) .card--flip.is-flipped .card__face {
    opacity: 1;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .card__back::after {
      animation: card-sheen calc(var(--dur-slow) * 2) var(--ease-in-out) calc(var(--dur-slow) + var(--i, 0) * 80ms) both;
    }
  }

  @keyframes card-sheen {
    to {
      translate: 110% 0;
    }
  }
</style>
