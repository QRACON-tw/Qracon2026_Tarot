---
import type { TarotCard } from '../../data/tarot';

interface Props {
  card: TarotCard;
  class?: string;
  flip?: boolean;
}

const { card, class: className, flip = false } = Astro.props;
---

<span class:list={['card', { 'card--flip': flip }, className]}>
  <span class="card__inner">
    <span class="card__face">
      <span class="card__ghost" aria-hidden="true"><span>{card.numeral}</span></span>
      <span class="card__numeral">{card.numeral}</span>
      <span class="card__name-en">{card.nameEn}</span>
      <span class="card__persona">{card.persona}</span>
    </span>
    {
      flip && (
        <span class="card__back" aria-hidden="true">
          <span class="card__sigil" />
        </span>
      )
    }
  </span>
</span>

<style>
  .card {
    position: relative;
    display: grid;
    width: 100%;
    aspect-ratio: 4 / 7;
    container-type: inline-size;
    border: var(--rule-thin) solid var(--color-ink);
    border-radius: var(--radius-chip);
    background: var(--color-white);
    color: var(--color-ink);
  }

  .card::before {
    content: '';
    position: absolute;
    inset: var(--space-2);
    border: var(--rule-hair) solid var(--color-ink);
    border-radius: var(--radius-tile);
    pointer-events: none;
  }

  .card__inner {
    display: contents;
  }

  .card__face {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-evenly;
    padding: 12cqw 6cqw;
    text-align: center;
  }

  /* Oversized numeral printed light behind the face, cropped by the hairline frame. */
  .card__ghost {
    position: absolute;
    inset: calc(var(--space-2) + var(--rule-hair));
    overflow: hidden;
    border-radius: max(0px, var(--radius-tile) - var(--rule-hair));
    color: var(--color-dim-surface-strong);
    font-family: var(--font-sign);
    font-weight: var(--weight-sign-heavy);
    font-size: 118cqw;
    line-height: 0.8;
    white-space: nowrap;
    pointer-events: none;
    user-select: none;
  }

  .card__ghost > span {
    position: absolute;
    left: 50%;
    bottom: 0;
    translate: -50% 14%;
  }

  .card__numeral,
  .card__name-en,
  .card__persona {
    position: relative;
  }

  .card__numeral {
    font-family: var(--font-sign);
    font-weight: var(--weight-sign-heavy);
    font-size: 18cqw;
    line-height: 1;
    letter-spacing: 0.08em;
    padding-inline-start: 0.08em;
  }

  .card__name-en {
    font-family: var(--font-sign);
    font-weight: var(--weight-sign-heavy);
    font-size: 10.5cqw;
    line-height: 1.1;
    letter-spacing: 0.14em;
    padding-inline-start: 0.14em;
    text-transform: uppercase;
    text-wrap: balance;
  }

  .card__persona {
    font-family: var(--font-sans);
    font-weight: var(--weight-black);
    font-size: 11cqw;
    line-height: var(--leading-tight);
    letter-spacing: 0.02em;
    padding-inline-start: 0.02em;
    text-wrap: balance;
  }

  .card--flip {
    border: 0;
    border-radius: 0;
    background: none;
    perspective: 40rem;
  }

  .card--flip::before {
    content: none;
  }

  .card--flip .card__inner {
    position: absolute;
    inset: 0;
    display: grid;
    transform-style: preserve-3d;
  }

  .card--flip .card__face,
  .card--flip .card__back {
    grid-area: 1 / 1;
    border-radius: var(--radius-chip);
    backface-visibility: hidden;
  }

  .card--flip .card__face {
    position: relative;
    border: var(--rule-thin) solid var(--color-ink);
    background: var(--color-white);
  }

  .card--flip .card__face::before {
    content: '';
    position: absolute;
    inset: var(--space-2);
    border: var(--rule-hair) solid var(--color-ink);
    border-radius: var(--radius-tile);
    pointer-events: none;
  }

  .card__back {
    position: relative;
    overflow: hidden;
    border: var(--rule-thin) solid var(--color-white);
    background: var(--color-ink-raised);
    transform: rotateY(180deg);
  }

  .card__back::before {
    content: '';
    position: absolute;
    inset: var(--space-2);
    border: var(--rule-hair) solid var(--color-on-ink-rule);
    border-radius: var(--radius-tile);
    background-image:
      linear-gradient(
        45deg,
        transparent calc(50% - var(--rule-hair)),
        var(--color-on-ink-rule) calc(50% - var(--rule-hair)) 50%,
        transparent 50%
      ),
      linear-gradient(
        -45deg,
        transparent calc(50% - var(--rule-hair)),
        var(--color-on-ink-rule) calc(50% - var(--rule-hair)) 50%,
        transparent 50%
      );
    background-size: 12cqw 12cqw;
    background-position: center;
  }

  .card__sigil {
    position: absolute;
    inset: 0;
    margin: auto;
    width: 24cqw;
    height: 24cqw;
    border: var(--rule-thin) solid var(--color-white);
    background: var(--color-ink-raised);
    rotate: 45deg;
  }

  .card__sigil::after {
    content: '';
    position: absolute;
    inset: 22%;
    border: var(--rule-hair) solid var(--color-on-ink-soft);
  }

  .card__back::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(105deg, transparent 38%, var(--color-on-ink-sheen) 50%, transparent 62%);
    opacity: 0.16;
    translate: -110% 0;
    pointer-events: none;
  }

  :global(.js) .card--flip .card__inner {
    transform: rotateY(180deg);
    transition: transform var(--dur-flip) var(--ease-in-out);
  }

  :global(.js) .card--flip.is-flipped .card__inner {
    transform: none;
  }

  :global([data-fx='0']) .card--flip .card__inner {
    transform: none;
    transition: none;
  }

  :global([data-fx='0']) .card--flip .card__face,
  :global([data-fx='0']) .card--flip .card__back {
    backface-visibility: visible;
    transition: opacity var(--dur-fast) linear;
  }

  :global([data-fx='0']) .card--flip .card__back {
    transform: none;
  }

  :global([data-fx='0']) .card--flip .card__face,
  :global([data-fx='0']) .card--flip.is-flipped .card__back {
    opacity: 0;
  }

  :global([data-fx='0']) .card--flip.is-flipped .card__face {
    opacity: 1;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .card__back::after {
      animation: card-sheen calc(var(--dur-slow) * 2) var(--ease-in-out) calc(var(--dur-slow) + var(--i, 0) * 80ms) both;
    }
  }

  @keyframes card-sheen {
    to {
      translate: 110% 0;
    }
  }
</style>
