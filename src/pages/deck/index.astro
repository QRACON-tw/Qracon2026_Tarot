---
import TarotLayout from '../../layouts/TarotLayout.astro';
import Card from '../../components/tarot/Card.astro';
import Button from '../../components/Button.astro';
import { site } from '../../data/site';
import { cards } from '../../data/tarot';
import { cardPath } from '../../utils/tarot';
---

<TarotLayout
  title={`疊加牌組｜${site.name}`}
  description="七張牌各對應一種量子態：疊加、糾纏、測量、躍遷、退相干、淬火、相干光。"
  image="/og/tarot-deck.png"
  imageAlt="七張量子塔羅牌面插畫"
>
  <div class="deck wrap">
    <header class="deck__intro">
      <h1>疊加牌組</h1>
      <p>七張牌，各對應一種量子態。點一張看完整牌義。</p>
    </header>
    <ul class="deck__list" role="list">
      {
        cards.map((card) => (
          <li>
            <a class="row" href={cardPath(card.id)}>
              <span class="row__card" aria-hidden="true">
                <Card card={card} />
              </span>
              <span class="row__text">
                <span class="row__name">
                  <span class="row__numeral">{card.numeral}</span>
                  <span>{card.name}</span>
                </span>
                <span class="row__persona">{card.persona}</span>
                <span class="row__concept">{card.concept.zh}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
    <Button href="/" variant="on-ink" icon="arrow-right">抽一張</Button>
  </div>
</TarotLayout>

<style>
  .deck {
    display: grid;
    justify-items: start;
    gap: var(--space-6);
    padding-block: var(--space-7) 0;
  }

  .deck__intro {
    display: grid;
    gap: var(--space-3);
  }

  h1 {
    font-size: var(--text-3xl);
    letter-spacing: 0.02em;
  }

  .deck__list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
    gap: var(--space-5) var(--space-6);
    width: 100%;
  }

  .row {
    display: grid;
    grid-template-columns: 7rem 1fr;
    align-items: center;
    gap: var(--space-4);
    padding-block: var(--space-3);
    border-top: var(--rule-hair) solid var(--color-on-ink-rule);
    text-decoration: none;
  }

  .row:hover .row__persona {
    text-decoration: underline;
    text-decoration-thickness: var(--rule-mid);
    text-underline-offset: 0.28em;
  }

  .row__text {
    display: grid;
    gap: var(--space-1);
  }

  .row__name {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    color: var(--color-on-ink-soft);
    font-weight: var(--weight-bold);
  }

  .row__numeral {
    font-family: var(--font-sign);
    font-weight: var(--weight-sign-heavy);
    font-size: var(--text-xl);
    letter-spacing: 0.08em;
    color: var(--color-white);
  }

  .row__persona {
    font-size: var(--text-xl);
    font-weight: var(--weight-black);
    line-height: var(--leading-tight);
  }

  .row__concept {
    color: var(--color-on-ink-soft);
    font-size: var(--text-sm);
  }
</style>
