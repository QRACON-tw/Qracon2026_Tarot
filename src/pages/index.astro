---
import TarotLayout from '../layouts/TarotLayout.astro';
import Card from '../components/tarot/Card.astro';
import FxCanvas from '../components/fx/FxCanvas.astro';
import { site } from '../data/site';
import { cards } from '../data/tarot';
import { cardPath } from '../utils/tarot';
import { sitePath } from '../utils/paths';

const deckPath = sitePath('/deck/');
const todayCards = Object.fromEntries(
  cards.map((card) => [card.id, { persona: card.persona, href: cardPath(card.id) }]),
);
---

<TarotLayout
  title={site.name}
  description={site.description}
  image="/og/tarot.png"
  imageAlt="七張量子塔羅牌插畫與牌背"
>
  <div class="draw wrap">
    <header class="draw__intro">
      <h1>你現在是哪一種量子態？</h1>
      <p class="draw__sub">七張牌，七種量子態。</p>
      <p class="draw__today" data-today data-cards={JSON.stringify(todayCards)} hidden>你今天抽到：<span class="draw__today-persona" data-today-persona></span><a class="draw__today-link" data-today-link href={deckPath}>再看一次</a></p>
      {/* Runs before first paint, so the line shows without shifting the layout. scripts/reveal.ts writes the key and its shape. */}
      <script is:inline>
        (() => {
          const KEY = 'qracon.tarot.today';
          const line = document.querySelector('[data-today]');
          if (!line) return;

          const fill = () => {
            try {
              const raw = localStorage.getItem(KEY);
              if (!raw) return;
              const saved = JSON.parse(raw);
              const now = new Date();
              const pad = (value) => String(value).padStart(2, '0');
              const day = now.getFullYear() + '-' + pad(now.getMonth() + 1) + '-' + pad(now.getDate());
              if (!saved || saved.day !== day) {
                localStorage.removeItem(KEY);
                return;
              }
              const cards = JSON.parse(line.dataset.cards);
              if (!Object.prototype.hasOwnProperty.call(cards, saved.id)) return;
              line.querySelector('[data-today-persona]').textContent = cards[saved.id].persona;
              line.querySelector('[data-today-link]').href = cards[saved.id].href;
              line.hidden = false;
            } catch (e) {}
          };

          fill();
          // A page restored from the back/forward cache does not run this script again.
          addEventListener('pageshow', (event) => {
            if (event.persisted) fill();
          });
        })();
      </script>
      <div class="draw__hint">
        <p>翻開之前，你不知道會是哪一張。</p>
        <p>翻開一張，其他六張就散了。</p>
        <a class="draw__deck-link" href={deckPath}>想快速看完七張牌？點「牌組」。</a>
      </div>
    </header>
    <ol class="draw__cards is-dealing" role="list" aria-label="七張牌，選一張翻開">
      {
        cards.map((card) => (
          <li>
            <a class="pick" href={cardPath(card.id)} data-card={card.id}>
              <Card card={card} flip />
            </a>
          </li>
        ))
      }
    </ol>
  </div>
  <FxCanvas />
</TarotLayout>

<script>
  import '../scripts/draw';
</script>

<style>
  .draw {
    display: grid;
    gap: var(--space-7);
    padding-block: var(--space-7) 0;
  }

  .draw__intro {
    display: grid;
    gap: var(--space-3);
    justify-items: center;
    text-align: center;
  }

  h1 {
    font-size: var(--text-3xl);
    letter-spacing: 0.02em;
  }

  .draw__sub {
    font-size: var(--text-lg);
    font-weight: var(--weight-bold);
  }

  .draw__hint {
    color: var(--color-on-ink-soft);
  }

  /* keep-all: a long persona wraps as a whole instead of leaving its last character beside the link. */
  .draw__today {
    color: var(--color-on-ink-soft);
    word-break: keep-all;
    overflow-wrap: anywhere;
  }

  .draw__today-persona {
    color: var(--color-white);
    font-weight: var(--weight-bold);
  }

  /* A real space, not a margin: it disappears when the link wraps, so the link stays aligned with the line above. */
  .draw__today-persona::after {
    content: ' ';
    word-spacing: var(--space-2);
  }

  .draw__deck-link,
  .draw__today-link {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--color-on-ink-soft);
    font-weight: var(--weight-bold);
    text-decoration-thickness: var(--rule-mid);
    text-underline-offset: 0.28em;
  }

  .draw__deck-link {
    margin-block-start: var(--space-1);
  }

  .draw__deck-link:hover,
  .draw__deck-link:focus-visible,
  .draw__today-link:hover,
  .draw__today-link:focus-visible {
    color: var(--color-white);
  }

  .draw__cards {
    --pick-w: clamp(5.5rem, 26vw, 8.25rem);
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-4) var(--space-3);
    max-inline-size: calc(var(--pick-w) * 3 + var(--space-3) * 2);
    margin-inline: auto;
  }

  .draw__cards li {
    inline-size: var(--pick-w);
  }

  @media (min-width: 48rem) {
    .draw__cards {
      --pick-w: 10.5rem;
      gap: var(--space-4);
      max-inline-size: calc(var(--pick-w) * 4 + var(--space-4) * 3);
    }
  }

  @media (orientation: landscape) and (max-height: 30rem) {
    .draw {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      column-gap: var(--space-6);
      padding-block: var(--space-4);
    }

    .draw__intro {
      justify-items: start;
      text-align: start;
    }

    h1 {
      font-size: var(--text-2xl);
    }

    .draw__hint {
      word-break: keep-all;
      overflow-wrap: anywhere;
    }

    /* Two rows of 4:7 cards fill the first screen below the 3rem header bar. */
    .draw__cards {
      --pick-w: clamp(4rem, (100svh - 3rem - var(--space-4) * 2 - var(--space-3)) * 2 / 7, 8.25rem);
      gap: var(--space-3);
      max-inline-size: calc(var(--pick-w) * 4 + var(--space-3) * 3);
    }
  }

  .draw__cards li:nth-child(1) { --i: 0; }
  .draw__cards li:nth-child(2) { --i: 1; }
  .draw__cards li:nth-child(3) { --i: 2; }
  .draw__cards li:nth-child(4) { --i: 3; }
  .draw__cards li:nth-child(5) { --i: 4; }
  .draw__cards li:nth-child(6) { --i: 5; }
  .draw__cards li:nth-child(7) { --i: 6; }

  .pick {
    display: block;
    border-radius: var(--radius-chip);
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }

  .draw__cards li.is-gone {
    translate: var(--fx-dx, 0px) var(--fx-dy, 0px);
    rotate: var(--fx-rot, 0deg);
    opacity: 0;
    transition:
      translate var(--dur-slow) var(--ease-out),
      rotate var(--dur-slow) var(--ease-out),
      opacity var(--dur-slow) var(--ease-in-out);
  }

  .draw__cards li.is-picked {
    scale: 1.08;
    transition: scale var(--dur-base) var(--ease-out);
  }

  :global(html.is-resolving) {
    overflow: hidden;
  }

  :global(html.is-resolving body) {
    overflow-x: clip;
  }

  :global(.has-vt) .draw__cards li.is-picked {
    position: relative;
    z-index: calc(var(--z-fx) + 1);
  }

  :global(.has-vt) .draw__cards li.is-picked :global(.card) {
    view-transition-name: tarot-card;
  }

  :global([data-fx='0']) .draw__cards li.is-gone {
    translate: none;
    rotate: none;
    transition: opacity var(--dur-fast) linear;
  }

  :global([data-fx='0']) .draw__cards li.is-picked {
    scale: none;
    transition: none;
  }

  @media (hover: hover) {
    :global(.js) .pick {
      transition: translate var(--dur-fast) var(--ease-out);
    }

    :global(.js) .draw__cards:not([aria-busy]) .pick:hover {
      translate: 0 calc(var(--space-1) * -1);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .draw__cards.is-dealing li {
      animation: card-deal var(--dur-slow) var(--ease-out) backwards;
      animation-delay: calc(var(--i) * 40ms);
    }
  }

  @keyframes card-deal {
    from {
      opacity: 0;
      transform: translate3d(0, var(--space-6), 0) rotate(calc((var(--i) - 3) * 1.5deg)) scale(0.94);
    }
  }
</style>
